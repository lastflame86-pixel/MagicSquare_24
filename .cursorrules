################################################################################
project:
  name: MagicSquare
  description: "4x4 Magic Square — 규칙 기반 판정(검증) 우선 QA·TDD 학습 프로젝트"
  python_version: "3.10+"
  primary_goal: "완전 4x4 격자에 대해 S·V·M·P 불변을 일관되게 판정"
  scope:
    in_scope:
      - "검증(Validator) 1차 TDD 사이클"
      - "IN/OUT 계약, violationIds (S/V/M/P)"
      - "RED-01 ~ RED-08 순차 구현"
    out_of_scope:
      - "생성(Generator) — G1~G3 게이트 전 금지"
      - "n×n 일반화, UI/CLI 본 구현, 성능 벤치마크"
  references:
    problem_definition: Report/MagicSquare-Problem-Definition-Report.md
    tdd_design: Report/MagicSquare-TDD-Design-Report.md
    implementation_prep: Report/MagicSquare-Implementation-Preparation-Report.md
  oracle: "특정 16칸 배치 한 장이 아니라 규칙 집합(S·V·M)으로 PASS/FAIL 판정"

################################################################################
code_style:
  python_version: "3.10+"
  style_guide: "PEP 8 엄격 준수 (pycodestyle / Ruff PEP8 규칙)"
  type_hints: "모든 함수·메서드의 파라미터와 반환값에 필수 (public·private 포함)"
  docstring: "Google 스타일 — 모든 public 클래스·함수·메서드에 필수"
  max_line_length: 88
  formatter: "Black (line-length=88) 권장"
  imports: "isort 호환 — 표준 라이브러리 → 서드파티 → 로컬"
  naming:
    modules_packages: snake_case
    classes: PascalCase
    functions_variables: snake_case
    constants: UPPER_SNAKE_CASE
  enums: "ValidationResult·RuleId 등 도메인 상태는 enum 또는 Literal 사용"

################################################################################
architecture:
  pattern: ECB
  layers:
    boundary:
      role: "외부 입출력 담당 — UI, API, CLI, 파일·JSON 파싱, 결과 직렬화"
      magicsquare_examples:
        - "GridInput — 원시 입력 → 정규화 격자 또는 REJECTED/INCOMPLETE"
        - "ValidationReporter — ValidationResult → OUT-01~04 관측 형태"
      must_not:
        - "S·V·M 마방진 규칙 판정 로직 포함"
        - "entity 내부 상태를 외부 계약 없이 변경"
    control:
      role: "비즈니스 로직·유스케이스 — 판정 흐름, S→V→M 순서, 위반 ID 부여"
      magicsquare_examples:
        - "MagicSquareValidator — validate(grid) → ValidationResult"
      must_not:
        - "CLI/파일 포맷 하드코딩"
        - "boundary 없이 외부 세계 직접 접근"
    entity:
      role: "도메인 데이터·규칙 — 격자 값 객체, RuleCatalog, ValidationResult, 불변 정의"
      magicsquare_examples:
        - "RuleCatalog — S1/S2/V1/M1~M4·I1~I7 매핑"
        - "ValidationResult — result, violation_ids, summary"
      must_not:
        - "입출력·프레임워크 의존"
        - "control·boundary import"
  dependency_direction:
    allowed:
      - "boundary → control → entity"
      - "control → entity"
      - "boundary → entity (DTO·값 객체 전달만, 판정 로직 없이)"
    forbidden:
      - "entity → control"
      - "entity → boundary"
      - "entity → pytest / stdlib 이외 인프라"
  design_reports: "Report/MagicSquare-TDD-Design-Report.md §6.2 컴포넌트와 동일 의미 유지"

################################################################################
tdd_rules:
  dual_track:
    track_a: "Report·Prompt·AC·RED 시나리오 문장 — 코드·테스트 본문 없음"
    track_b: "tests/ Red → src/ Green → Refactor"
  red_phase:
    description: "실패하는 테스트를 먼저 작성하고, pytest로 Red임을 확인한 뒤에만 구현으로 넘어간다."
    rules:
      - "RED-ID 순서 준수: RED-01 → RED-02 → … → RED-08 (G-02)"
      - "tests/에 Given-When-Then·AC-ID·RED-ID를 테스트명·docstring에 명시"
      - "구현 전 pytest 실행 — 해당 테스트가 실패하는지 확인"
      - "실패 원인은 「미구현·스텁」이어야 하며, 잘못된 assert 기대는 수정"
      - "Track B만 다룸 — Report 수정은 사용자가 Track A를 요청할 때만"
    must_not:
      - "src/ 프로덕션 로직을 Red 확인 없이 추가·확장"
      - "한 PR·한 턴에 RED 2건 이상 동시 Green"
      - "assert 완화·삭제·@pytest.mark.skip/xfail로 Red 제거"
      - "다음 RED(M/V) 규칙을 현재 RED보다 먼저 구현"
  green_phase:
    description: "현재 Red 1건을 통과시키는 최소 코드만 src/에 추가한다."
    rules:
      - "MagicSquareValidator·GridInput 등 — 현재 RED에 필요한 최소 분기만"
      - "OUT 계약: result, violation_ids(필수 시), summary"
      - "pytest로 해당 RED + 기존 P0 회귀 통과 확인"
      - "문서 §8.3 허용 부채만: 유효 격자 1종, 최초 위반 ID 1개, 고정 요약 문자열"
    must_not:
      - "리팩터링·공통 추출·이름 일괄 변경·RuleCatalog 일원화"
      - "다른 RED·전체 M1~M4·Generator 한 번에 구현"
      - "PASS/FAIL/NOT_APPLICABLE 의미 변경"
      - "테스트 기대값을 구현에 맞게 약화"
  refactor_phase:
    description: "동작·AC·테스트 기대는 그대로 두고 구조만 개선한다."
    rules:
      - "현재 RED Green + P0 회귀 통과 후에만 시작"
      - "중복 제거, RuleCatalog 일원화, S→V→M 순서 통합 테스트 고정"
      - "Refactor 전후 pytest 동일 통과 (P0 최소)"
      - "커버리지 80% 목표 유지·하락 시 테스트 추가 후 Refactor"
    must_not:
      - "기능 추가·새 RED 선행 구현"
      - "관측 가능 동작·violation ID 의미 변경"
      - "실패 테스트 삭제·xfail 남용"
      - "Green 단계에서 미뤄둔 리팩터를 Red 없이 대량 수행"

################################################################################
testing:
  framework: pytest
  pattern: "AAA (Arrange-Act-Assert) — 빈 줄 또는 주석으로 세 구역 구분"
  coverage_minimum: "80%"
  coverage_note: "RED 1건만 있을 때는 신규 모듈 80% 미달 가능 — RED 누적 시 점진 충족"
  fixture_scope:
    function: "격자·ValidationResult 등 테스트별 독립 데이터 (기본)"
    class: "동일 클래스 내 테스트만 공유할 때"
    module: "파일 단위 read-only 상수"
    session: "금지에 가깝게 — 반드시 필요 시만, mutable 공유 금지"
    conftest: "tests/conftest.py — 공통 픽스처·RED-ID 헬퍼"
    fixtures_dir: "tests/fixtures/grids/ — JSON 격자 (red01_input_3x4.json 등)"
  naming_convention:
    files: "test_<REDID>_<rule>_<behavior>.py"
    functions: "test_ 접두사 필수 — 예: test_RED01_given_3x4_when_parse_then_rejected_with_S1"
    classes: "Test<Component> 선택 — 메서드는 test_ 유지"
  markers:
    unit: "tests/unit/"
    integration: "tests/integration/"
  assert_style: "result·violation_ids를 명시적으로 검증 — 골든 배열 전체 일치 금지(비불변)"

################################################################################
forbidden:
  - pattern: "print("
    reason: "디버깅 출력은 CI·테스트 오염, 관측 계약(OUT) 우회"
    alternative: "logging (logging.getLogger(__name__)) 또는 ValidationResult.summary / pytest 실패 메시지"
  - pattern: "하드코딩된 마방 상수·격자 (매직 넘버 34, 16칸 고정 배열을 비즈니스 코드 전역에 산재)"
    reason: "RuleCatalog·entity에 규칙이 있어야 AC-12·변경 일관성 유지"
    alternative: "RuleCatalog.MAGIC_CONSTANT, GridSize.ROWS, entity/constants 모듈"
  - pattern: "except:"
    reason: "PEP 8 E722 — 모든 예외 삼키기, 실패 원인 은닉"
    alternative: "except SpecificError as e: 로 구체 예외 처리 후 재raise 또는 도메인 오류 변환"
  - pattern: "except Exception: pass"
    reason: "동일 — 판정 실패·입력 오류가 PASS로 이어질 수 있음"
    alternative: "명시적 예외 타입 + 로깅 + REJECTED/NA 반환"
  - pattern: "src/ 변경 without 대응 failing test in tests/"
    reason: "tdd_rules Red 위반 — RED 없이 구현"
    alternative: "먼저 tests/에 Red 추가·pytest 실패 확인 후 src/ 최소 구현"
  - pattern: "assert expected == entire_fixed_16_cell_grid"
    reason: "비불변 — 특정 배치를 유일 정답으로 고정"
    alternative: "assert result == PASS 및 규칙 ID; 유효 격자 2종 이상 샘플"
  - pattern: "@pytest.mark.skip / xfail (Red 제거 목적)"
    reason: "테스트 약화 — P2·AC-10 위반"
    alternative: "구현 또는 기대 Then 수정(Report·AC 기준)"
  - pattern: "if not valid: return True"
    reason: "P2 — 위반 시 통과 금지"
    alternative: "FAIL + violation_ids (V1/M1 등)"

################################################################################
file_structure:
  tree: |
    MagicSquare/
    ├── .cursorrules
    ├── Report/                          # Track A — 설계·AC (코드 없음)
    ├── Prompt/
    ├── src/
    │   └── magicsquare/
    │       ├── __init__.py
    │       ├── entity/                    # ECB — 도메인·규칙
    │       │   ├── __init__.py
    │       │   ├── rule_catalog.py
    │       │   ├── validation_result.py
    │       │   └── grid.py              # 격자 값 객체 (선택)
    │       ├── control/                   # ECB — 판정 유스케이스
    │       │   ├── __init__.py
    │       │   └── magic_square_validator.py
    │       └── boundary/                  # ECB — 입출력
    │           ├── __init__.py
    │           ├── grid_input.py          # IN-01~06
    │           └── validation_reporter.py # OUT-01~04
    └── tests/
        ├── conftest.py
        ├── fixtures/
        │   └── grids/
        │       └── red01_input_3x4.json
        ├── unit/
        │   ├── boundary/
        │   │   └── test_RED01_S1_non_4x4_dimensions.py
        │   └── control/
        └── integration/
            └── control/
  legacy_mapping:
    note: "Implementation-Preparation-Report의 domain→entity, validation→control, input|output→boundary"
    domain: entity/
    validation: control/
    input: boundary/grid_input.py
    output: boundary/validation_reporter.py

################################################################################
ai_behavior:
  before_coding:
    - "Report/MagicSquare-TDD-Design-Report.md 및 현재 RED-ID·AC 확인"
    - "수정·생성할 tests/ 파일 경로를 먼저 제시 — RED-ID와 매핑"
    - "관련 기존 테스트 파일·conftest·fixtures 존재 여부 확인"
    - "Track A(Report만) vs Track B(코드) 구분 — 사용자 요청 없으면 Report 수정 안 함"
  during_coding:
    - "ECB 의존 방향 위반 금지 — entity는 control·boundary import 불가"
    - "타입 힌트 없는 def 생성 금지 — -> None 포함"
    - "public API에 Google docstring 필수"
    - "Red 단계: tests/만 변경 — Green 단계: 현재 RED에 필요한 src/만 최소 추가"
    - "tdd_rules 위반 감지 시 구현 중단하고 채팅에 ⚠️ TDD 위반: <항목> 경고 출력"
  after_coding:
    - "pytest 실행 제안 또는 결과 요약 (가능한 경우)"
    - "변경 파일 목록과 RED-ID·AC 링크 명시"
    - "다음 단계: Red 확인 / Green / Refactor 중 어디인지 명시"
  warnings_emit_when:
    - "src/ 변경인데 대응 Red 테스트 없음"
    - "Green 단계에서 리팩터·다중 RED 동시 처리"
    - "forbidden 패턴(print, bare except, 테스트 약화) 감지"
    - "NOT_APPLICABLE과 FAIL 혼용 (STEP 2 OUT 계약 위반)"
  must_not_claim:
    - "pytest·커버리지 80%를 실행하지 않고 통과를 보장했다고 단정"
    - "사용자 대신 RED 실패를 확인했다고 거짓 보고"
